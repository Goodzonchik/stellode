{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node"],
    "rootDir": ".",
    "tsBuildInfoFile": "../../dist/out-tsc/apps/backend/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": ["**/*.ts"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.integration.spec.ts",
    "jest.config.ts",
    "jest.integration.config.ts"
  ]
}
