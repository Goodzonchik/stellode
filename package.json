  "scripts": {
    "f": "nx serve frontend",
    "b": "nx serve backend",
    "test:backend": "nx run backend:test",
    "test:backend:ci": "nx run backend:test --configuration=ci",
    "test:backend:integration": "nx run backend:integration-test",
    "test:models": "nx run models:test",
    "test:models:ci": "nx run models:test --configuration=ci",
    "test:frontend": "nx run frontend:test",
    "test": "nx run-many --target=test --projects=backend,models,frontend",
    "test:ci": "nx run-many --target=test --projects=backend,models,frontend --configuration=ci",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:clear": "node scripts/db-clear.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "help:sync": "node scripts/help-sync.mjs",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
