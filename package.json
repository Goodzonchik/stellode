    "react-dom": "^19.1.1",
    "react-router-dom": "^7.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "private": true,
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.0.2",
    "@nx/eslint-plugin": "22.0.2",
    "@nx/jest": "22.0.2",
    "@nx/js": "22.0.2",
    "@testing-library/dom": "^10.4.2",
