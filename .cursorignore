# Директории зависимостей (все node_modules на любом уровне)
**/node_modules/

# Сборки и временные файлы
**/dist/
**/build/
**/.next/
**/.nuxt/
**/.output/
**/.cache/
**/.turbo/
**/.parcel-cache/

# Покрытие тестов
**/coverage/
**/.nyc_output/

# Логи и временные файлы
*.log
*.tmp
*.swp
*.swo
*.pid
*.seed
*.pid.lock

# Файлы окружения
.env
.env.*
!.env.example

# Системные файлы
.DS_Store
Thumbs.db
desktop.ini

# IDE и редакторы
.vscode/
.idea/
.nx/
*.sublime-*

# Сгенерированные файлы типов
**/*.d.ts.map
**/*.js.map
**/*.js.map
**/tsconfig.tsbuildinfo

# Файлы, специфичные для монореп
packages/*/lib/
packages/*/dist/
packages/*/coverage/

# Артефакты npm/yarn/pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Кеш тестов
.jest-cache/
.cache/

